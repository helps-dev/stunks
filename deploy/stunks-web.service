# Web app as a systemd service.
#
#   sudo cp deploy/stunks-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now stunks-web
#
# Run `pnpm --filter @stunks/web build` before starting, and again after every
# `git pull`. `next start` serves a build; it does not create one.

[Unit]
Description=STUNKS.FUN web app
Documentation=https://github.com/helps-dev/stunks/blob/main/docs/DEPLOY_VPS.md
After=network-online.target
Wants=network-online.target

# Crash-loop backoff. These belong in [Unit]: systemd ignores them in [Service]
# and says so in a line that is easy to miss, because the unit still loads and
# every other directive works. Ignored, with Restart=always and RestartSec=5s,
# a failing process restarted every five seconds forever — hammering the RPC
# endpoints this was written to protect.
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/stunks/apps/web

# PATH first, EnvironmentFile second — the ORDER is the point.
#
# systemd applies these in the order written and the last one wins, so a PATH set here
# would override one set in .env. This way round the line below is a default and each
# machine can correct it without editing a committed file.
#
# The default is deliberately plain, because no committed value can be right
# everywhere: a Node installed by nvm lives under a VERSION-NUMBERED directory, and
# pnpm installed by corepack lives beside whichever Node installed it. On one real
# server `node` came from ~/.local/bin while `pnpm` came from an nvm v22 directory, and
# neither was on this list. The service failed with status 127 — "command not found" —
# which says nothing about which command.
#
# To get it right on a given machine, run this as the service user and put the result
# in .env:
#
#   echo "PATH=$PATH" >> ~/stunks/.env
#
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Credentials come from the file, never from this unit — this file is committed.
# It may also carry PATH, which then overrides the default above.
EnvironmentFile=/home/ubuntu/stunks/.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1

# Bound to localhost on purpose: Caddy or nginx terminates TLS in front of it. Binding
# 0.0.0.0 here would serve wallet traffic over plain HTTP.
ExecStart=/usr/bin/env pnpm exec next start --hostname 127.0.0.1 --port 3000

Restart=always
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/stunks
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=stunks-web

[Install]
WantedBy=multi-user.target
