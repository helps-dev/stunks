# Web app as a systemd service.
#
#   sudo cp deploy/stunks-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now stunks-web
#
# Run `pnpm --filter @stunks/web build` before starting, and again after every
# `git pull`. `next start` serves a build; it does not create one.

[Unit]
Description=STUNKS.FUN web app
Documentation=https://github.com/helps-dev/stunks/blob/main/docs/DEPLOY_VPS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stunks
Group=stunks
WorkingDirectory=/home/stunks/stunks/apps/web

EnvironmentFile=/home/stunks/stunks/.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1

# Bound to localhost on purpose: Caddy or nginx terminates TLS in front of it. Binding
# 0.0.0.0 here would serve wallet traffic over plain HTTP.
ExecStart=/usr/bin/env pnpm exec next start --hostname 127.0.0.1 --port 3000

Restart=always
RestartSec=5s
StartLimitBurst=5
StartLimitIntervalSec=120

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/stunks/stunks
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=stunks-web

[Install]
WantedBy=multi-user.target
