# TLS front door for the web app.
#
# DOMAIN and ACME_EMAIL come from .env. Caddy requests and renews the certificate
# itself, so nothing here holds a key.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# The health endpoint is deliberately absent. It is an internal, unauthenticated
	# operational view and stays bound to localhost on the VPS — enforced by
	# HEALTH_HOST on the indexer, not by the absence of a route here.
	reverse_proxy web:3000

	# ── Rate limit ────────────────────────────────────────────────────────────────
	#
	# Every page is `force-dynamic`, so each request reaches the database and, on the
	# landing page, the chain. Those chain reads go to the same free public endpoints
	# the indexer depends on, and the indexer is already the constrained party: dRPC
	# and OrdoFi had 5,314 and 4,975 recorded failures with the curve stream 715,288
	# blocks behind. Without a limit here, holding down refresh is enough to take RPC
	# budget away from the indexer.
	#
	# This needs the rate_limit module, which is not in the standard image:
	#
	#   docker build -t stunks-caddy - <<'EOF'
	#   FROM caddy:2-builder AS builder
	#   RUN xcaddy build --with github.com/mholt/caddy-ratelimit
	#   FROM caddy:2-alpine
	#   COPY --from=builder /usr/bin/caddy /usr/bin/caddy
	#   EOF
	#
	# Then point the caddy service at stunks-caddy. Until that image is built, leave
	# this block commented out — Caddy refuses to start on an unknown directive, and
	# an unstarted front door is worse than an unlimited one.
	#
	# rate_limit {
	# 	zone per_ip {
	# 		key    {remote_host}
	# 		events 120
	# 		window 1m
	# 	}
	# }

	header {
		# Security headers are set by the APP, in apps/web/next.config.mjs, so they
		# apply wherever it is served — including on Vercel, where nothing in this file
		# is in the request path. Repeating them here would mean two CSP headers, which
		# a browser intersects: a confusing way to find out one of them was wrong.
		#
		# Only what belongs to the front door stays.
		-Server
	}
}
