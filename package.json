{
  "name": "stunks",
  "version": "0.1.0",
  "private": true,
  "description": "STUNKS.FUN — non-custodial token launchpad and trading platform on Robinhood Chain, built on Pons V2",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && pnpm typecheck:scripts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.json",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:db": "pnpm --filter @stunks/database test:integration",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "verify:pons": "tsx --env-file-if-exists=.env scripts/verify-pons.ts",
    "probe:exemptions": "tsx --env-file-if-exists=.env scripts/probe-exemption-limit.ts",
    "probe:sources": "tsx --env-file-if-exists=.env scripts/probe-log-sources.ts",
    "verify:db": "tsx --env-file-if-exists=.env scripts/verify-database.ts",
    "inspect:indexed": "tsx --env-file-if-exists=.env scripts/inspect-indexed.ts",
    "moderate": "tsx --env-file-if-exists=.env scripts/moderate.ts",
    "recompute:prices": "tsx --env-file-if-exists=.env scripts/recompute-prices.ts",
    "score:trending": "tsx --env-file-if-exists=.env scripts/score-trending.ts",
    "prune:trades": "tsx --env-file-if-exists=.env scripts/prune-trades.ts",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:format": "prisma format --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@prisma/client": "6.1.0",
    "@types/node": "22.10.2",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "prisma": "6.1.0",
    "tsx": "4.19.2",
    "turbo": "2.3.3",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "viem": "2.21.55",
    "vitest": "2.1.8"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "ws": ">=8.21.0"
    }
  }
}
