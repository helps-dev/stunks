# ─────────────────────────────────────────────────────────────────────────────
# STUNKS.FUN environment
#
# Copy to .env and fill in. Never commit .env.
# Every value here was verified against Robinhood Chain mainnet during the
# Phase 0 audit — see docs/PONS_V2_INTEGRATION.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Chain ────────────────────────────────────────────────────────────────────
# 4663 = Robinhood Chain mainnet. 46630 = testnet (not yet verified by us).
CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_ID=4663

# ── RPC endpoints, in failover order ─────────────────────────────────────────
# Comma-separated. The pool tries them in order and demotes unhealthy ones.
#
# Verified working during the audit:
#   https://robinhood.drpc.org              archive; small eth_getLogs windows
#   https://rpc.ordofi.network              used by third-party Pons tooling
#   https://rpc.nodeflare.app/robinhood/public   ~2 req/s; returns HTML on throttle
#
# The official endpoint is https://rpc.mainnet.chain.robinhood.com — prefer it in
# production. It was unreachable from the audit machine because that network
# intercepts robinhood.com DNS.
RPC_ENDPOINTS=https://robinhood.drpc.org,https://rpc.ordofi.network

# Frontend uses its own list so a browser never depends on a private endpoint.
NEXT_PUBLIC_RPC_ENDPOINTS=https://robinhood.drpc.org,https://rpc.ordofi.network

# ── Pons V2 ──────────────────────────────────────────────────────────────────
# This is the ONLY Pons address that is configured. Every other Pons address
# (hook, executor, deployer, locker, buyback vault, guard, router, PoolManager,
# PositionManager, fee escrow) is read from this factory on-chain at runtime,
# because the protocol owner can rotate several of them.
PONS_V2_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
NEXT_PUBLIC_PONS_V2_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e

# Block the V2 factory was deployed at, found by binary search over eth_getCode.
# The indexer starts here; scanning from genesis would be 26.8M wasted blocks.
INDEXER_START_BLOCK=26841846

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres. A hosted dev instance (Neon, Supabase) is the least friction since
# this machine has neither Docker nor a local postgres.
#
# TWO urls are needed, and the difference matters:
#   DATABASE_URL  pooled   — used by the application at runtime
#   DIRECT_URL    unpooled — used by `prisma migrate`, because DDL through a
#                            connection pooler is unreliable
#
# On Neon the direct host is the same string with "-pooler" removed.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── Cache (not used in Phase 1) ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Integration tests ────────────────────────────────────────────────────────
# Live read-only tests against mainnet are skipped unless this is "1", so a
# normal `pnpm test` never depends on the network.
RUN_LIVE_TESTS=0

# Database integration tests run against a real Postgres and are skipped unless
# this is "1". They use the synthetic chain id 9999999 so they can never touch
# indexed mainnet rows — see R27 in docs/KNOWN_RISKS.md for why that matters.
RUN_DB_TESTS=0

# ── Indexer ──────────────────────────────────────────────────────────────────
# Every value here has a working default; they are listed because two of them
# decide whether a backfill takes minutes or roughly two days.
#
# BACKFILL_SOURCE is the one to get right. Over RPC, backfilling 36.8M blocks at
# a 100-block window was measured at ~51 hours. HyperSync answers millions of
# blocks per query; the token is free from https://app.envio.dev/api-tokens.
BACKFILL_SOURCE=rpc
# HYPERSYNC_BEARER_TOKEN=
# HYPERSYNC_URL=https://robinhood.hypersync.xyz

# Stop once both streams reach the confirmed head, instead of tailing forever.
BACKFILL_ONLY=0

# Blocks held back from the head before a block is treated as settled. ~1.2s at
# this chain's 101 ms block time, so the cost of being careful here is trivial.
CONFIRMATION_DEPTH=12

# Initial eth_getLogs window. Adapts at runtime and is persisted per stream.
LOG_WINDOW=100

# Pause between live-tail ticks. ~10 blocks at 101 ms per block.
TAIL_INTERVAL_MS=1000

# Health endpoint. It reports checkpoints, RPC endpoint URLs and failure counts
# with NO authentication in front of it, so HEALTH_HOST — not the port — is what
# keeps it private. Override it only inside a container, where loopback is
# unreachable from the host and a 127.0.0.1 port mapping does the same job.
HEALTH_PORT=9464
HEALTH_HOST=127.0.0.1

# ── HTTPS front door (docker compose --profile public) ───────────────────────
# Caddy obtains and renews the certificate itself using these two values.
DOMAIN=stunks.fun
ACME_EMAIL=you@example.com
