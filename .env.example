# ─────────────────────────────────────────────────────────────────────────────
# STUNKS.FUN environment
#
# Copy to .env and fill in. Never commit .env.
# Every value here was verified against Robinhood Chain mainnet during the
# Phase 0 audit — see docs/PONS_V2_INTEGRATION.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Chain ────────────────────────────────────────────────────────────────────
# 4663 = Robinhood Chain mainnet. 46630 = testnet (not yet verified by us).
NEXT_PUBLIC_CHAIN_ID=4663

# ── RPC endpoints, in failover order ─────────────────────────────────────────
# Comma-separated. The pool tries them in order and demotes unhealthy ones.
#
# Verified working during the audit:
#   https://robinhood.drpc.org              archive; small eth_getLogs windows
#   https://rpc.ordofi.network              used by third-party Pons tooling
#   https://rpc.nodeflare.app/robinhood/public   ~2 req/s; returns HTML on throttle
#
# The official endpoint is https://rpc.mainnet.chain.robinhood.com — prefer it in
# production. It was unreachable from the audit machine because that network
# intercepts robinhood.com DNS.
RPC_ENDPOINTS=https://robinhood.drpc.org,https://rpc.ordofi.network

# Frontend uses its own list so a browser never depends on a private endpoint.
NEXT_PUBLIC_RPC_ENDPOINTS=https://robinhood.drpc.org,https://rpc.ordofi.network

# ── Pons V2 ──────────────────────────────────────────────────────────────────
# This is the ONLY Pons address that is configured. Every other Pons address
# (hook, executor, deployer, locker, buyback vault, guard, router, PoolManager,
# PositionManager, fee escrow) is read from this factory on-chain at runtime,
# because the protocol owner can rotate several of them.
PONS_V2_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
NEXT_PUBLIC_PONS_V2_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e

# Block the V2 factory was deployed at, found by binary search over eth_getCode.
# The indexer starts here; scanning from genesis would be 26.8M wasted blocks.
INDEXER_START_BLOCK=26841846

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres. A hosted dev instance (Neon, Supabase) is the least friction since
# this machine has neither Docker nor a local postgres.
DATABASE_URL=postgresql://user:password@host:5432/stunks?sslmode=require

# ── Cache (not used in Phase 1) ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Integration tests ────────────────────────────────────────────────────────
# Live read-only tests against mainnet are skipped unless this is "1", so a
# normal `pnpm test` never depends on the network.
RUN_LIVE_TESTS=0
